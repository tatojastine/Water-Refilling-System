# Local mode serves the page and API on the same localhost origin.
HOST=127.0.0.1
PORT=8765
# Set to the exact browser frontend origin for a separate local dev server.
# CLIENT_URL=http://127.0.0.1:5173
# Use JSON locally or set MONGODB_URI to use an Atlas database.
# AQUA_DATA_FILE=./data/accounts-state.json
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER_HOST/?retryWrites=true&w=majority
# MONGODB_DB=aquarefresh

# Hosting provider environment (keep values out of git).
# NODE_ENV=production
# HOST=0.0.0.0
# CLIENT_URL=https://YOUR-SITE.netlify.app
# MONGODB_URI must be set for production. PORT is assigned by the backend host.
